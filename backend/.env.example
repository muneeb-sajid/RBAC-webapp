# Server
PORT=4000
NODE_ENV=development

# CORS - the origin your React frontend runs on
CLIENT_ORIGIN=http://localhost:5173

# JWT
JWT_SECRET=replace-this-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# MongoDB
MONGO_URI=mongodb://localhost:27017/rbac-admin
